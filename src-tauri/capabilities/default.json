{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main and pop-out session windows",
  "windows": [
    "main",
    "pop-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-always-on-top",
    "dialog:default"
  ]
}
